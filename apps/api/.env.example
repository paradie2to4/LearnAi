# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://learnai:learnai@localhost:5432/learnai?schema=public
# Optional: only needed when DATABASE_URL points at a pooled connection (e.g. Neon's
# "-pooler" endpoint) - `prisma migrate` uses this non-pooled URL instead. See the
# `directUrl` comment in schema.prisma.
DIRECT_URL=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# RabbitMQ
RABBITMQ_URL=amqp://learnai:learnai@localhost:5672

# AI (Google Gemini - the default provider, free tier via aistudio.google.com, no card required)
# Optional in local/dev: if unset, AI endpoints respond with 503 instead of crashing the app.
GOOGLE_API_KEY=
AI_MODEL_ID=gemini-1.5-flash
# Only read if ai.module.ts's AI_PROVIDER binding is switched to AnthropicProvider.
ANTHROPIC_API_KEY=

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
